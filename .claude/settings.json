{
  "permissions": {
    "allow": [
      "Bash(python3 -m panel:*)",
      "Bash(python -m panel:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(npm test:*)",
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(npx playwright:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(cmake:*)",
      "Bash(ctest:*)",
      "Bash(python scripts/:*)",
      "Bash(python3 .claude/hooks/:*)",
      "Bash(python .claude/hooks/:*)",
      "Bash(mkdir -p .claude/state)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push)",
      "Bash(git push:*)",
      "Bash(python -m scraper.winners:*)",
      "Bash(python -m analysis.location_trends:*)",
      "Bash(python -m analysis.complexity:*)",
      "Bash(pip install -r requirements-dev.txt)",
      "Bash(cp _incoming_harness/:*)",
      "Bash(rm -r _incoming_harness)",
      "Bash(rm -r _to_delete)",
      "Read(**)",
      "Edit(**)",
      "Write(**)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/secrets/**)"
    ]
  },
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/gate.sh",
            "timeout": 1200
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/gate.sh",
            "timeout": 1200
          }
        ]
      }
    ]
  }
}